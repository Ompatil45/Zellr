# Copy to .env and fill in values:
#   cp .env.example .env

# Cloudflare R2 → R2 → Manage R2 API Tokens → Create API token (Object Read & Write)

# Access Key ID     ← from the API token you created (S3 credentials)
ACCESS_KEY_ID=your_r2_access_key_id

# Secret Access Key ← shown once when you create the token — copy it immediately
SECRET_ACCESS_KEY=your_r2_secret_access_key

# Account ID        ← Cloudflare dashboard sidebar, or R2 overview page
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Bucket name       ← exact name from R2 → Buckets (e.g. zellr-bucket)
R2_BUCKET_NAME=zellr-bucket

# --- Redis (local dev only; docker compose uses redis://redis:6379 internally) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Next.js (baked into web image at build time) ---
NEXT_PUBLIC_UPLOAD_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_DOMAIN=zellr.localhost

# Local docker compose:
# NEXT_PUBLIC_UPLOAD_API_URL=http://localhost:4000
